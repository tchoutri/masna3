packages:
  ./server
  ./api
  ./masna3-prelude
  ./background-jobs

with-compiler: ghc-9.10.3
with-hc-pkg: ghc-pkg-9.10.3
semaphore: True
tests: True
jobs: $ncpus
multi-repl: True
split-sections: True

package *
  gcc-options: -march=native
  split-sections: True

allow-newer:
  amazonka-s3:*,
  amazonka:*,
  pg-entity:*,
  arbiter-worker:random,

allow-older:
  arbiter-worker:random,

source-repository-package
  type: git
  location: https://github.com/eclipse-biscuit/biscuit-haskell
  tag: 01ffc8e9bcf87b025b82af99868dfcf26a2ef42a
  subdir:
    ./biscuit
    ./biscuit-servant

source-repository-package
  type: git
  location: https://github.com/brendanhay/amazonka/
  tag: a7d699be1076e2aad05a1930ca3937ffea954ad8
  subdir:
    ./lib/amazonka
    ./lib/amazonka-core
    ./lib/services/amazonka-s3
    ./lib/services/amazonka-sso
    ./lib/services/amazonka-sts

source-repository-package
  type: git
  location: https://github.com/velveteer/arbiter.git
  tag: 08a78b8abc4de2204131d499fb7c170d83dd8135
  subdir:
    arbiter-core
    arbiter-worker
    arbiter-simple
    arbiter-migrations
    arbiter-servant
    arbiter-servant-ui
